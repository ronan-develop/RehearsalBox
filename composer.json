{
    "name": "ronan-develop/rehearsalbox",
    "description": "Gestion des disponibilités d'un local de répétition partagé entre groupes de musique.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "psr/log": "^3",
        "symfony/clock": "^8.1",
        "symfony/mailer": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Tools\\": "tools/"
        }
    },
    "scripts": {
        "test:quick": "phpunit --exclude-group db"
    },
    "config": {
        "sort-packages": true
    }
}
